# Bitcoin Core Node Configuration
BITCOIN_RPC_HOST=127.0.0.1
BITCOIN_RPC_PORT=8332
BITCOIN_RPC_USER=your_rpc_username
BITCOIN_RPC_PASSWORD=your_rpc_password

# Database Configuration
BITCOIN_DB_PATH=bitcoin_data.db

# Server Configuration
PORT=3000
NODE_ENV=production

# Presence Authentication
PRESENCE_SECRET_KEY=your_secret_key_here_change_this_in_production

# API Configuration
API_RATE_LIMIT=100
CACHE_TTL_SECONDS=10

# Network Configuration
BITCOIN_NETWORK=mainnet

# Logging
LOG_LEVEL=info

# Optional: External Services
# PRICE_API_KEY=your_price_api_key
# NOTIFICATION_WEBHOOK=your_webhook_url
